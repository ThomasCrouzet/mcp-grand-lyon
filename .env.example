# Copy these variables to the user secrets.env file or the process environment.
# The binary does not load a repository .env file.
# Never commit credentials.
DATAGRANDLYON_USERNAME=
DATAGRANDLYON_PASSWORD=

# Optional path overrides (platform-specific defaults)
GRAND_LYON_MCP_CONFIG_DIR=
GRAND_LYON_MCP_DATA_DIR=
GRAND_LYON_MCP_DB_PATH=

# Runtime
GRAND_LYON_MCP_LOG_LEVEL=INFO
GRAND_LYON_MCP_OFFLINE=false
GRAND_LYON_MCP_HTTP_CONNECT_TIMEOUT_SECONDS=5
GRAND_LYON_MCP_HTTP_READ_TIMEOUT_SECONDS=20
GRAND_LYON_MCP_MAX_PARALLEL_REQUESTS=6
GRAND_LYON_MCP_VERIFY_TLS=true

# Optional Transitous journey planner
TRANSITOUS_ENABLED=false
TRANSITOUS_BASE_URL=https://api.transitous.org/api/
