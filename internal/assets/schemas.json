{
  "lyon_resolve_place": {
    "name": "lyon_resolve_place",
    "description": "Resolve an address, TCL stop, Vélo'v station, district, or personal place in Lyon. Use this tool to resolve ambiguous locations before other tools.",
    "inputSchema": {
      "$defs": {
        "PlaceRef": {
          "additionalProperties": false,
          "description": "Exactly one of place_id, query, coordinates, or profile_place.",
          "properties": {
            "place_id": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Place Id"
            },
            "query": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Query"
            },
            "latitude": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Latitude"
            },
            "longitude": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Longitude"
            },
            "profile_place": {
              "anyOf": [
                {
                  "maxLength": 64,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Profile Place"
            }
          },
          "title": "PlaceRef",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "query": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "near": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlaceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "types": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 20,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Types"
        },
        "limit": {
          "default": 5,
          "maximum": 20,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "query"
      ],
      "title": "ResolvePlaceInput",
      "type": "object"
    }
  },
